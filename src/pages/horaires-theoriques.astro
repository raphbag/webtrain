---
import Layout from '../layouts/Layout.astro';
import FormTheoreticalSchedule from '../components/formTheoreticalSchedule.astro';
---

<Layout title="WebTrain - Horaires Théoriques">
	<div class="min-h-screen bg-slate-900 pt-28 px-4 pb-12">
        <div class="max-w-4xl mx-auto">
            <h1 class="text-3xl font-bold text-white mb-2 text-center drop-shadow-md">Horaires Planifiés (Théoriques)</h1>
            <p class="text-slate-300 text-center mb-8 max-w-2xl mx-auto">
                Prévoyez vos trajets à l'avance en consultant les horaires de départ théoriques depuis n'importe quelle gare de la région Île-de-France.
            </p>
            <FormTheoreticalSchedule />
        </div>
	</div>
</Layout>
