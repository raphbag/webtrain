# Clé API pour le développement local Google Maps (publique - visible côté client)
# Obtenir une clé sur : https://console.cloud.google.com/google/maps-apis
# ⚠️ IMPORTANT : Sécurisez votre clé avec des restrictions :
#    1. Restrictions HTTP referrers (ex: votre-domaine.com/*)
#    2. Restrictions d'API (Maps JavaScript API uniquement)
#    3. Quotas et alertes de facturation
PUBLIC_GOOGLE_MAPS_API_KEY=votre_cle_google_maps_ici

# Clé API développement local Île-de-France Mobilités (PRIM)
# Obtenir une clé sur : https://prim.iledefrance-mobilites.fr/
IDFM_API_KEY=votre_cle_idfm_ici

# API SNCF (Navitia)
# Username: clé API SNCF (ex: UUID)
# Password: laisser vide si non fourni par SNCF
SNCF_API_USERNAME=votre_username_sncf_ici
SNCF_API_PASSWORD=

# SIRI Lite SNCF (transport.data.gouv.fr) ne nécessite pas de clé API.

